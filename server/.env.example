# Server
PORT=5002
NODE_ENV=development

# MongoDB — use either variable name (both are supported)
MONGODB_URI=mongodb://localhost:27017/sishuarogaya
# MONGO_URI=mongodb://localhost:27017/sishuarogaya

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5175

# Local AI (Ollama) — used by the chatbot and growth-prediction insights
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=90000

# Google Gemini AI (optional backup when Ollama is down)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# SMTP (tried first for OTP email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# SendGrid (fallback for OTP email; dev mode returns OTP in response if neither works)
SENDGRID_API_KEY=SG.your_sendgrid_key_here
SENDGRID_FROM_EMAIL=sishuarogaya@yourdomain.com

# SMS from your own SIM: install "SMS Gate" (sms-gate.app) on an Android phone, turn on Cloud server,
# and copy its username/password here. For local mode use SMS_GATEWAY_URL=http://<phone-ip>:8080/message
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/messages
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=

# WhatsApp from your own number: set true, start the server, scan the QR from WhatsApp → Linked devices
WHATSAPP_ENABLED=false
# Optional: use an installed Chrome instead of Puppeteer's download
# WHATSAPP_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome


# Load balancer (npm start → cluster.js): number of API workers; defaults to one per CPU core
# WEB_CONCURRENCY=4
# Max in-flight chatbot LLM calls per API worker (extra questions get the knowledge-base answer)
# LLM_MAX_CONCURRENT=2
# Load shedding: in-flight API requests per worker before answering 503 "busy"
# MAX_INFLIGHT_PER_WORKER=256

# ── HTTPS (pick one) ──────────────────────────────────────────────────────────
# A) Node serves HTTPS itself: certificate + key files (e.g. from Let's Encrypt). With HTTP_PORT set,
#    that port only redirects to HTTPS. Restart after renewing the certificate.
# SSL_KEY_FILE=/etc/letsencrypt/live/example.in/privkey.pem
# SSL_CERT_FILE=/etc/letsencrypt/live/example.in/fullchain.pem
# PORT=443
# HTTP_PORT=80
# B) nginx / a cloud load balancer terminates HTTPS in front: number of proxy hops (usually 1).
#    Plain-HTTP visitors are then redirected to HTTPS. Never set this without a proxy in front.
# TRUST_PROXY=1
# Optional: public hostname used in HTTPS redirects instead of the request's Host header
# PUBLIC_HOST=example.in
