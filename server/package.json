{
  "name": "sishu-arogaya-server",
  "version": "1.0.0",
  "description": "Sishu Arogaya Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:who": "node seedWHO.js",
    "seed:data": "node seedFullData.js",
    "seed:all": "node seed.js && node seedWHO.js && node seedFullData.js",
    "seed:hospitals": "node seedHospitals.js",
    "seed:hospitals:force": "node seedHospitals.js --force",
    "seed:schemes": "node seedSchemes.js",
    "seed:schemes:force": "node seedSchemes.js --force",
    "seed:diet": "node seedDiet.js",
    "seed:everything": "node seed.js && node seedWHO.js && node seedDiet.js && node seedHospitals.js && node seedSchemes.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "natural": "^8.1.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
